{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rewind",
  "version": "1.0.0",
  "identifier": "dev.rewind.recorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Rewind",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "shadow": true,
        "backgroundColor": "#141210"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://asset.localhost asset:; media-src 'self' http://asset.localhost asset:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
